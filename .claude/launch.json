{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8788", "--bind", "127.0.0.1"],
      "port": 8788
    },
    {
      "name": "worker",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "dev", "--config", "worker/wrangler.toml", "--port", "8787"],
      "port": 8787
    }
  ]
}
